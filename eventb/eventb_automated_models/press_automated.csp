// ================================================================
// PAT CSP# Model: press_7
// Translated from Event-B using the provided conversion rules
// ================================================================

// Rule 2: Context press_ctx_0 — partition(STATUS, {stopped}, {working})
enum {stopped, working};

// Rule 2: Context press_ctx_2 — partition(CLUTCH, {engaged}, {disengaged})
enum {engaged, disengaged};

// Rule 2: Context press_ctx_3 — partition(DOOR, {open, closed})
enum {open, closed};

// Rule 3A: Standard initialisation from INITIALISATION event
var motor_actuator = stopped;
var motor_sensor = stopped;
var start_motor_button = false;
var start_motor_impulse = false;
var stop_motor_button = false;
var stop_motor_impulse = false;
var clutch_actuator = disengaged;
var clutch_sensor = disengaged;
var door_actuator = open;
var door_sensor = open;
var m = false;
var start_clutch_button = false;
var start_clutch_impulse = false;
var stop_clutch_button = false;
var stop_clutch_impulse = false;

// Rule 7: System process — all events joined by external choice []
// Rule 4: Each non-INITIALISATION event maps to one PAT event
// Rule 5: Guards from WHERE clauses conjoined with &&
// Rule 6: Actions from THEN clauses in statement blocks
// Rule 9: Operator conversions applied (= -> ==, := -> =, TRUE/FALSE -> true/false, negation, conjunction)

System() =

    // Rule 4,5,6: motor_start
    [motor_sensor == stopped && motor_actuator == working]
    motor_start { motor_sensor = working; } -> System()

    []

    // Rule 4,5,6: motor_stop
    [motor_sensor == working && motor_actuator == stopped]
    motor_stop { motor_sensor = stopped; } -> System()

    []

    // Rule 4,5,6: clutch_start
    [clutch_sensor == disengaged && clutch_actuator == engaged]
    clutch_start { clutch_sensor = engaged; } -> System()

    []

    // Rule 4,5,6: clutch_stop
    [clutch_sensor == engaged && clutch_actuator == disengaged]
    clutch_stop { clutch_sensor = disengaged; } -> System()

    []

    // Rule 4,5,6: door_close
    [door_sensor == open && door_actuator == closed]
    door_close { door_sensor = closed; } -> System()

    []

    // Rule 4,5,6: door_open
    [door_sensor == closed && door_actuator == open]
    door_open { door_sensor = open; } -> System()

    []

    // Rule 4,5,6: push_start_motor_button
    [start_motor_button == false]
    push_start_motor_button { start_motor_button = true; } -> System()

    []

    // Rule 4,5,6: release_start_motor_button
    [start_motor_button == true]
    release_start_motor_button { start_motor_button = false; } -> System()

    []

    // Rule 4,5,6: push_stop_motor_button
    [stop_motor_button == false]
    push_stop_motor_button { stop_motor_button = true; } -> System()

    []

    // Rule 4,5,6: release_stop_motor_button
    [stop_motor_button == true]
    release_stop_motor_button { stop_motor_button = false; } -> System()

    []

    // Rule 4,5,6: push_start_clutch_button
    [start_clutch_button == false]
    push_start_clutch_button { start_clutch_button = true; } -> System()

    []

    // Rule 4,5,6: release_start_clutch_button
    [start_clutch_button == true]
    release_start_clutch_button { start_clutch_button = false; } -> System()

    []

    // Rule 4,5,6: push_stop_clutch_button
    [stop_clutch_button == false]
    push_stop_clutch_button { stop_clutch_button = true; } -> System()

    []

    // Rule 4,5,6: release_stop_clutch_button
    [stop_clutch_button == true]
    release_stop_clutch_button { stop_clutch_button = false; } -> System()

    []

    // Rule 4,5,6: treat_start_motor
    [motor_sensor == stopped && motor_actuator == stopped && start_motor_impulse == false && start_motor_button == true]
    treat_start_motor { motor_actuator = working; start_motor_impulse = true; } -> System()

    []

    // Rule 4,5,6,9: treat_start_motor_false
    // Rule 9: ¬(motor_sensor = stopped ∧ motor_actuator = stopped) -> !(motor_sensor == stopped && motor_actuator == stopped)
    [start_motor_impulse == false && start_motor_button == true && !(motor_sensor == stopped && motor_actuator == stopped)]
    treat_start_motor_false { start_motor_impulse = true; } -> System()

    []

    // Rule 4,5,6: treat_stop_motor
    [motor_sensor == working && motor_actuator == working && stop_motor_impulse == false && stop_motor_button == true && clutch_sensor == disengaged && clutch_actuator == disengaged && door_sensor == open && door_actuator == open]
    treat_stop_motor { motor_actuator = stopped; stop_motor_impulse = true; } -> System()

    []

    // Rule 4,5,6,9: treat_stop_motor_false
    // Rule 9: ¬(motor_sensor = working ∧ motor_actuator = working ∧ clutch_sensor = disengaged ∧ clutch_actuator = disengaged ∧ door_sensor = open ∧ door_actuator = open)
    [stop_motor_impulse == false && stop_motor_button == true && !(motor_sensor == working && motor_actuator == working && clutch_sensor == disengaged && clutch_actuator == disengaged && door_sensor == open && door_actuator == open)]
    treat_stop_motor_false { stop_motor_impulse = true; } -> System()

    []

    // Rule 4,5,6: treat_release_start_motor_button
    [start_motor_impulse == true && start_motor_button == false]
    treat_release_start_motor_button { start_motor_impulse = false; } -> System()

    []

    // Rule 4,5,6: treat_release_stop_motor_button
    [stop_motor_impulse == true && stop_motor_button == false]
    treat_release_stop_motor_button { stop_motor_impulse = false; } -> System()

    []

    // Rule 4,5,6: treat_start_clutch
    [clutch_actuator == disengaged && clutch_sensor == disengaged && motor_sensor == working && motor_actuator == working && door_sensor == closed && door_actuator == closed && m == true]
    treat_start_clutch { clutch_actuator = engaged; m = false; } -> System()

    []

    // Rule 4,5,6: treat_stop_clutch
    [clutch_actuator == engaged && clutch_sensor == engaged && stop_clutch_impulse == false && stop_clutch_button == true]
    treat_stop_clutch { clutch_actuator = disengaged; stop_clutch_impulse = true; } -> System()

    []

    // Rule 4,5,6,9: treat_stop_clutch_false
    // Rule 9: ¬(clutch_sensor=engaged ∧ clutch_actuator = engaged)
    [stop_clutch_impulse == false && stop_clutch_button == true && !(clutch_sensor == engaged && clutch_actuator == engaged)]
    treat_stop_clutch_false { stop_clutch_impulse = true; } -> System()

    []

    // Rule 4,5,6: treat_close_door
    [door_actuator == open && door_sensor == open && motor_sensor == working && motor_actuator == working && start_clutch_impulse == false && start_clutch_button == true]
    treat_close_door { door_actuator = closed; m = true; start_clutch_impulse = true; } -> System()

    []

    // Rule 4,5,6,9: treat_close_door_false
    // Rule 9: ¬(motor_sensor=working ∧ motor_actuator=working ∧ door_actuator=open ∧ door_sensor=open)
    [start_clutch_impulse == false && start_clutch_button == true && !(motor_sensor == working && motor_actuator == working && door_actuator == open && door_sensor == open)]
    treat_close_door_false { start_clutch_impulse = true; } -> System()

    []

    // Rule 4,5,6: treat_open_door
    [door_actuator == closed && door_sensor == closed && clutch_sensor == disengaged && clutch_actuator == disengaged && m == false]
    treat_open_door { door_actuator = open; } -> System()

    []

    // Rule 4,5,6: treat_release_start_clutch_button
    [start_clutch_impulse == true && start_clutch_button == false]
    treat_release_start_clutch_button { start_clutch_impulse = false; } -> System()

    []

    // Rule 4,5,6: treat_release_stop_clutch_button
    [stop_clutch_impulse == true && stop_clutch_button == false]
    treat_release_stop_clutch_button { stop_clutch_impulse = false; } -> System()
;



// Manual Verification (not generated)
#assert System deadlockfree;

#assert System() |= [](treat_stop_clutch -> (!treat_start_clutch U (door_open || []!treat_start_clutch)));

#assert System() |= [](treat_stop_clutch -> (!treat_close_door U (door_open || []!treat_close_door)));


#define clutchEngaged (clutch_sensor == engaged && clutch_actuator == engaged);
#define motorWorking (motor_sensor == working && motor_actuator == working);
#define doorClosed (door_sensor == closed && door_actuator == closed);

#assert System() |= [](!clutchEngaged || motorWorking);
#assert System() |= [](!clutchEngaged || doorClosed);
