// ============================================================
// PAT CSP# Model — translated from Event-B (file_3 / file_ctx1)
// ============================================================

// ============================================================
// Rule 1: Undefined constants — D, f, n
// ============================================================
// "D" is used in "d :∈ D" (non-deterministic assignment).
//     D appears to be a finite domain/set for data values.
//     Handled via Rule 3C (see Init_d below and enum declaration).
//
// "n" is used as a loop bound: guards "r = n+1" and "s ≠ n+1"
//     indicate iteration from 1 to n. Assigned a reasonable value.
//
// "f" is used as a function: "d ≔ f(s)" with s ranging from 1 to n.
//     Handled via Rule 8C (undefined function, auto-populated).

// Rule 1: numeric constant inferred from usage as loop bound
#define n 3;

// ============================================================
// Rule 8A: Context function — parity
// ============================================================
// parity ∈ ℕ → ℤ with:
//   parity(0) = 0
//   parity(x+1) = 1 − parity(x)
// Domain inferred: parity is applied to s and r, which range
// from 1 to n+1. So we need indices 0..n+1.
// Evaluating the recursion:
//   parity(0) = 0
//   parity(1) = 1 - 0 = 1
//   parity(2) = 1 - 1 = 0
//   parity(3) = 1 - 0 = 1
//   parity(4) = 1 - 1 = 0
// With n=3, we need up to index n+1=4.

// Rule 8A: function from context converted to array
#define parity_size 5;
var parity[parity_size] = [0, 1, 0, 1, 0];

// ============================================================
// Rule 8C: Undefined function — f
// ============================================================
// f is used as f(s) where s ranges from 1 to n (i.e. 1..3).
// No axioms define f's values. Auto-populated with distinct
// default values (index as value) per Rule 8C.
// NOTE: Default values used for f — user should verify.

// Rule 8C: undefined function auto-populated with distinct defaults
#define f_size 4;
var f[f_size] = [-1, 1, 2, 3];

// ============================================================
// Rule 2 / Rule 3C: Non-deterministic set D
// ============================================================
// d :∈ D means d is initialised to an arbitrary member of D.
// D is not defined in the provided input. We model it as a
// small enumerated set per Rule 3C.
// NOTE: D is not provided — using placeholder values {d0, d1, d2}.
// User should verify or replace with actual domain values.

// Rule 2 / Rule 3C: enumeration for set D
enum {d0, d1, d2};

// ============================================================
// Rule 3: Variable declarations from INITIALISATION
// ============================================================

// Rule 3B: h ≔ ∅ — empty-set initialisation
// h is later used as h(r) ≔ d, with r ranging from 1 to n+1.
// Array size inferred from max index: r goes up to n before
// the assignment, and the final guard is r = n+1, so max
// index used in h(r) ≔ d is n. Size = n+1.
var h[n + 1] = [-1(n + 1)];

// Rule 3A: standard initialisation
var r = 1;

// Rule 3A: standard initialisation
var s = 1;

// Rule 3C: d :∈ D — non-deterministic initialisation
// d is always written (in send: d ≔ f(s)) before being read
// (in receive: h(r) ≔ d), so the initial value has no effect.
// Simplification applies: declare without initial value.
var d;

// Rule 3A: standard initialisation
var p = 1;

// Rule 3A: standard initialisation
var q = 1;

// Rule 3A: standard initialisation (FALSE -> false)
var b = false;

// ============================================================
// Rule 4, 5, 6, 7: Events assembled into System process
// ============================================================
// Events: final, receive, send
// INITIALISATION is excluded per Rule 3.
// REFINES, ANY, WITH fields are ignored per Rule 4.
// Invariants (inv1, inv2) are excluded per scope rules.
// Guard labels thm1, thm2 in send are translated uniformly
// per Rule 5 (all WHERE predicates regardless of label).

// Rule 7: System process with all events joined by external choice
System() =

    // Rule 4: event "final"
    // Rule 5: guards — r = n+1 conjoined with b = FALSE
    // Rule 6: actions — b ≔ TRUE
    // Rule 9: = becomes ==, FALSE becomes false, TRUE becomes true
    [r == n + 1 && b == false] final{b = true;} -> System()

    []

    // Rule 4: event "receive"
    // Rule 5: guard — p ≠ q
    // Rule 6: actions — h(r) ≔ d; r ≔ r+1; q ≔ 1−q
    // Rule 8B: h(r) converted to h[r]
    // Rule 9: ≠ becomes !=, ≔ becomes =, − becomes -
    [p != q] receive{h[r] = d; r = r + 1; q = 1 - q;} -> System()

    []

    // Rule 4: event "send"
    // Rule 5: guards — p = q, s ≠ n+1, p=parity(s), q=parity(r)
    // Rule 8B: parity(s) -> parity[s], parity(r) -> parity[r], f(s) -> f[s]
    // Rule 9: = becomes ==, ≠ becomes !=, ≔ becomes =, − becomes -
    [p == q && s != n + 1 && p == parity[s] && q == parity[r]] send{d = f[s]; s = s + 1; p = 1 - p;} -> System();

// ============================================================
// Assertions (examples — user should define as needed)
// ============================================================

// Rule 7: No non-deterministic init processes needed (d simplified),
// so System() is the top-level process.


// Manual Verification (not generated)

#define file_copied (b == true &&
    h[1] == f[1] &&
    h[2] == f[2] &&
    h[3] == f[3]  );
#assert System() |=<> file_copied;

#define piecewise 
    ((!(r > 1) || h[1] == f[1]) && 
     (!(r > 2) || h[2] == f[2]) && 
     (!(r > 3) || h[3] == f[3])
     );
#assert System |= [] piecewise;


#define inv1 p == parity[s];
#assert System() |=[] inv1;

#define inv2 q == parity[r];
#assert System() |=[] inv2;